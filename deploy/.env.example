# Copy to deploy/.env and fill in the DNS name and absolute certificate-directory path.
# This file contains no credentials. Keep deploy/.env and certificate keys out of Git.
SCOPLEN_SERVER_HOST=sync.example.com
SCOPLEN_HTTPS_PORT=8443
SCOPLEN_BIND_ADDRESS=0.0.0.0
# Allow authenticated Accounts to create teams. Existing membership reads remain available when false.
SPL_ORGANIZATIONS_ALLOW_CREATION=false
# Existing directory with fullchain.pem and private-key.pem, readable by container UID 65532.
SCOPLEN_TLS_DIRECTORY=
