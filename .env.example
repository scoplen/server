# Non-secret configuration overrides. Empty values are ignored by the loader.
SPL_CONFIG=spl-server.toml
SPL_SERVER_LISTEN_ADDR=127.0.0.1
SPL_SERVER_LISTEN_PORT=8443
SPL_SERVER_PUBLIC_HOST=localhost
SPL_SERVER_PUBLIC_PORT=443
SPL_SERVER_DATA_DIR=./data
SPL_TLS_MODE=plain
# SPL_TLS_CERT_FILE=/etc/scoplen/tls/fullchain.pem
# SPL_TLS_KEY_FILE=/etc/scoplen/tls/private-key.pem
# SPL_TLS_ACME_EMAIL=operator@example.com
# SPL_TLS_ACME_PRODUCTION=true
SPL_STORAGE_BACKEND=sqlite
# SPL_STORAGE_DATABASE_URL=postgres://scoplen:change-me@db.example.com/scoplen
# SPL_STORAGE_KMS_BACKEND=local
# SPL_STORAGE_KMS_KEY_FILE=./data/deployment.key
# SPL_STORAGE_KMS_AUDIT_KEY_FILE=./data/audit-signing.key
# SPL_STORAGE_OBJECT_BACKEND=filesystem
# SPL_STORAGE_OBJECT_DIRECTORY=./data/objects
# SPL_STORAGE_OBJECT_S3_BUCKET=scoplen-production
# SPL_STORAGE_OBJECT_S3_REGION=us-east-1
# SPL_STORAGE_OBJECT_S3_ENDPOINT=https://s3.example.com
# SPL_STORAGE_OBJECT_S3_ACCESS_KEY_ID=replace-me
# SPL_STORAGE_OBJECT_S3_SECRET_ACCESS_KEY=replace-me
# SPL_STORAGE_OBJECT_S3_ALLOW_HTTP=false
SPL_ROLES_NAMES=all
