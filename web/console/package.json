{
  "name": "@scoplen/server-console",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5193 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/build-assets.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5193 --strictPort",
    "test": "node --test src/*.test.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "9.39.1",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
